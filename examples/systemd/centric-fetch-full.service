[Unit]
Description=centric-fetch: full fetch from Centric PLM (flags deletions), then database upkeep
Documentation=https://github.com/eemax/centric-fetch
After=network-online.target
Wants=network-online.target
# No Conflicts= with the incremental unit: that would stop a running fetch. If one is running,
# this waits for it (--wait) rather than skip the week's full fetch.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/centric-fetch fetch --config /etc/centric-fetch/config.json --full --maintain --wait 1h
TimeoutStartSec=4h
TimeoutStopSec=60
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/centric-fetch

[Unit]
Description=centric-fetch: incremental fetch from Centric PLM
Documentation=https://github.com/eemax/centric-fetch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Exit 0 = ok or warn, 1 = partial or failed, 2 = config/credentials/lock. Units that should
# run after a good fetch can hook in with OnSuccess= in a drop-in.
ExecStart=/usr/local/bin/centric-fetch fetch --config /etc/centric-fetch/config.json
# A stop (or this timeout) ends it cleanly with exit 143; the next run resumes.
TimeoutStartSec=90min
TimeoutStopSec=60
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/centric-fetch
